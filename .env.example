# === Database (Postgres) ===
DB_USER=compliance_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=compliance_db


# === MinIO (object storage, AD-6) ===
# Used for client documents, FIU exports, audit archives, verification artifacts
# с Object Lock включённым.
#
# SECURITY:
# - Root credentials используются ТОЛЬКО minio-init для bootstrap (создание bucket, scoped user).
# - Backend подключается через scoped user MINIO_BACKEND_USER с policy=readwrite.
# - Host порты bind на 127.0.0.1 (см. docker-compose.yml).

# Root credentials (для minio-init bootstrap, НЕ для backend)
MINIO_ROOT_USER=compliance_minio_admin
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_ADMIN_STRONG_PASSWORD

# Scoped backend credentials (с readwrite policy, передаются backend сервису)
MINIO_BACKEND_USER=compliance_backend
MINIO_BACKEND_PASSWORD=CHANGE_ME_MINIO_BACKEND_STRONG_PASSWORD


# === FastAPI / Backend ===
SECRET_KEY=CHANGE_ME_SECRET_KEY_64_CHARS_MIN


# === Licensing (AD-4) ===
# License public key (для validation подписанного JWT):
# Путь относительно backend container; в Phase 1 файл будет добавлен в репо
# по адресу backend/app/license/public_key.pem (mount в /app/license/public_key.pem).
#
# Master password (AD-Q5) — НЕ ЗАДАЁТСЯ В .env.
# Master password вводится при старте приложения через interactive prompt.
# Этот placeholder используется в Phase 4+ когда AD-Q5 будет имплементирован.
MASTER_PASSWORD_PROMPT_REQUIRED=false


# === Legacy (deprecated, для backward compat — удалить после Phase 1) ===
# Эти переменные будут заменены на signed JSON-token (AD-4) в Phase 1.
LICENSE_SERVER_URL=https://license.yourcompany.com
COMPANY_LICENSE_KEY=YOUR_LICENSE_KEY_HERE
