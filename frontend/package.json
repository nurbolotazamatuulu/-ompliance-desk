{
  "name": "compliance-desk-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "ComplianceDesk-VASP frontend monorepo (compliance, back-office, client-portal SPAs + shared)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:compliance": "npm run dev --workspace=compliance-frontend",
    "dev:backoffice": "npm run dev --workspace=backoffice-frontend",
    "dev:portal": "npm run dev --workspace=client-portal-frontend",
    "build": "npm run build --workspaces --if-present",
    "build:compliance": "npm run build --workspace=compliance-frontend",
    "build:backoffice": "npm run build --workspace=backoffice-frontend",
    "build:portal": "npm run build --workspace=client-portal-frontend",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
